var ths = document.querySelectorAll("th");
var tbody = document.querySelector("tbody");
var currentSortIndex = null;
var currentSortDirection = 1;
var parseNumber = function(str) {
    var cleaned = str.replace(/[^0-9.-]+/g, "");
    if (cleaned === "") return null;
    var num = Number(cleaned);
    return Number.isNaN(num) ? null : num;
};
ths.forEach(function(th, index) {
    th.addEventListener("click", function() {
        var trsArray = Array.from(tbody.querySelectorAll("tr"));
        if (currentSortIndex === index) currentSortDirection *= -1;
        else {
            currentSortIndex = index;
            currentSortDirection = 1;
        }
        trsArray.sort(function(rowA, rowB) {
            var cellA = rowA.querySelectorAll("td")[index].textContent.trim();
            var cellB = rowB.querySelectorAll("td")[index].textContent.trim();
            var numA = parseNumber(cellA);
            var numB = parseNumber(cellB);
            if (numA !== null && numB !== null) return (numA - numB) * currentSortDirection;
            else return cellA.localeCompare(cellB, "en", {
                sensitivity: "base"
            }) * currentSortDirection;
        });
        tbody.innerHTML = "";
        trsArray.forEach(function(row) {
            return tbody.appendChild(row);
        });
    });
});
tbody.addEventListener("click", function(e) {
    if (e.target.closest("tr")) {
        tbody.querySelectorAll("tr").forEach(function(row) {
            return row.classList.remove("active");
        });
        e.target.closest("tr").classList.add("active");
    }
});
